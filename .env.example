# NEARMARK local application defaults (Testnet read-only inspection)
PORT=8787
ALLOWED_ORIGIN=http://localhost:5173
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_RPC_FALLBACK_URL=https://rpc.testnet.fastnear.com
FASTNEAR_TX_API=https://tx.test.fastnear.com/v0/account
FASTNEAR_API_KEY=

# Optional: NEAR AI Cloud. The app labels inference as unverified until the
# official NEAR AI Cloud Verifier has verified the exact response/attestation.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017-abliterated

# Optional: OutLayer read-only inspection. Keep these server-side only.
OUTLAYER_API_URL=https://testnet-api.outlayer.ai
OUTLAYER_API_KEY=
OUTLAYER_WALLET_ID=

# Comma-separated operator-curated addresses only; pending user reports do not block.
NEARMARK_VERIFIED_BLOCKLIST=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1/
NEAR_AI_PCCS_URL=https://api.trustedservices.intel.com/
NEAR_AI_NRAS_URL=https://nras.attestation.nvidia.com/v3/attest/gpu
NEAR_AI_NVIDIA_JWKS_URL=https://nras.attestation.nvidia.com/.well-known/jwks.json
